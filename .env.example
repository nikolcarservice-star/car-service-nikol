# Domena (canonical, sitemap, OG) — bez „www”; żądania www.* → 301 na ten host (middleware)
NEXT_PUBLIC_SITE_URL=https://autoserwis-nikol.pl

# Wersja RU (domyślnie włączona — /ru, przełącznik PL/RU). Wyłączenie:
# NEXT_PUBLIC_RUSSIAN_LOCALE_ENABLED=false

# Galeria /gallery (domyślnie wyłączona)
# NEXT_PUBLIC_GALLERY_ENABLED=true

# Google Analytics 4 — Measurement ID (np. G-XXXXXXXXXX)
# Pobierz w: Admin → Data Streams → wybierz strumień → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1N7H9RJBMX

# HubSpot — Portal ID (tracking code js.hs-scripts.com). Domyślnie w kodzie: 148417505
# Wyłączenie: ustaw pustą wartość lub zmień ID w HubSpot → Settings → Tracking & analytics
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=148417505

# Google Search Console — weryfikacja meta tag
# W Search Console: Właściwość → Ustawienia → Weryfikacja → meta tag → skopiuj content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Reviews (Places API)
# Klucz API z Google Cloud (Maps / Places API)
GOOGLE_PLACES_API_KEY=
# ID wizytówki Google (place_id)
GOOGLE_PLACES_PLACE_ID=

# Czat „Nikol” — wyłącznie Google Gemini (Generative Language API).
# Klucz: https://aistudio.google.com/apikey — Vercel → Environment Variables → włącz dla Production → Redeploy
#
# WAŻNE (częsta przyczyna „czat nie działa” na Vercel):
# W Google Cloud → APIs & Services → Credentials → ten klucz → „Application restrictions”
# NIE ustawiaj TYLKO „HTTP referrers (web sites)” — wywołanie idzie z serwera Vercel, bez referrera jak w przeglądarce → 403.
# Dla klucza używanego wyłącznie w zmiennych środowiskowych serwera: „None” LUB osobny klucz tylko pod backend.
# W Network (DevTools) odpowiedź POST /api/chat ma pole `reason` z komunikatem Google (np. PERMISSION_DENIED).
#
# Bez klucza czat zwraca error „missing_key”; przy błędzie modelu sprawdź logi: [chat] Gemini SDK
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # ten sam klucz, alternatywna nazwa
# GOOGLE_AI_API_KEY=              # kolejny alias (nie używaj NEXT_PUBLIC_* — klucz musi być tylko po stronie serwera)
# API_Gemini=                     # nazwa z Vercel (obsługiwana); zalecane: GEMINI_API_KEY
# Opcjonalnie własna kolejność modeli (domyślnie kod próbuje kilka nazw po kolei):
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL_FALLBACK=gemini-1.5-flash
