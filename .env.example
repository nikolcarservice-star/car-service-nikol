# Domena (dla canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://carservicenikol.pl

# Wersja RU (gdy true — /ru, przełącznik PL/RU; domyślnie wyłączone)
# NEXT_PUBLIC_RUSSIAN_LOCALE_ENABLED=true

# Galeria /gallery (domyślnie wyłączona)
# NEXT_PUBLIC_GALLERY_ENABLED=true

# Google Analytics 4 — Measurement ID (np. G-XXXXXXXXXX)
# Pobierz w: Admin → Data Streams → wybierz strumień → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8ZGESKN77X

# Google Search Console — weryfikacja meta tag
# W Search Console: Właściwość → Ustawienia → Weryfikacja → meta tag → skopiuj content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Reviews (Places API)
# Klucz API z Google Cloud (Maps / Places API)
GOOGLE_PLACES_API_KEY=
# ID wizytówki Google (place_id)
GOOGLE_PLACES_PLACE_ID=

# Powiadomienia o zapisie z formularza — Telegram Bot API
# Utwórz bota w @BotFather, token wklej TYLKO do .env.local / Vercel (nie commituj).
# TELEGRAM_CHAT_ID: napisz /start do bota, potem GET https://api.telegram.org/bot<TOKEN>/getUpdates
# — w polu message.chat.id znajdziesz swój chat_id (np. 123456789).
# Bez pierwszej wiadomości do bota (/start) Telegram zwróci błąd „can't initiate conversation”.
# Token tylko w Vercel (Environment Variables) lub .env.local — nie commituj.
# (opcjonalnie alias: TELEGRAM_TOKEN)
TELEGRAM_BOT_TOKEN=
# Domyślnie też w vercel.json (możesz nadpisać w Vercel)
TELEGRAM_CHAT_ID=5916910236

# Opcjonalnie: własny webhook (JSON jak wcześniej)
# BOOKING_WEBHOOK_URL=

# Opcjonalnie: Supabase tabela booking_requests
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
